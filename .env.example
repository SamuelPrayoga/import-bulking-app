# Email dari service account Google Cloud (lihat langkah "Prasyarat setup" di plan)
GOOGLE_SERVICE_ACCOUNT_EMAIL=nama-service-account@nama-project.iam.gserviceaccount.com

# Private key dari JSON key service account. Tempel persis seperti di file JSON (termasuk \n literal).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID Google Sheet respons Form (dari URL: https://docs.google.com/spreadsheets/d/<ID_INI>/edit)
GOOGLE_SHEET_ID=

# Nama tab + range kolom respons di Sheet tsb (kolom A-G: Timestamp, Email, Nama PIC, No WA PIC,
# Provinsi - Kabupaten/Kota, Link Drive file, Jabatan; H-J kosong; K: Status). Sesuaikan nama tab
# kalau berbeda, dan lebar range kalau posisi kolom Status di Sheet kamu beda.
GOOGLE_SHEET_RANGE="Form Responses 1!A:K"

# Login admin. Email boleh diedit langsung; password TIDAK pernah disimpan sebagai teks biasa —
# hanya salt + hash scrypt-nya. Untuk ganti password, jalankan:
#   npx tsx scripts/hashPassword.ts "password-baru"
# lalu salin dua baris output-nya ke sini.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=

# Secret untuk menandatangani session login (string acak panjang, sekali generate lalu diamkan).
SESSION_SECRET=

# Kosongkan di lokal (pakai file SQLite lokal otomatis). Diisi hanya di Vercel — URL & token
# database Turso, didapat dari `turso db create` + `turso db tokens create` (lihat Turso CLI,
# gratis, tanpa kartu: https://docs.turso.tech/cli/installation).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Wajib diisi di Vercel (bebas nilainya, string acak) supaya /api/cron/auto-pull cuma bisa dipicu
# oleh job terjadwal kita sendiri (lihat .github/workflows/auto-pull.yml), bukan sembarang orang.
# Nilainya harus sama persis dengan secret CRON_SECRET di GitHub repo settings.
CRON_SECRET=

# Auto-generate oleh Vercel saat kamu bikin Blob store dari tab Storage project (dipakai fitur
# Backup) — biasanya tidak perlu diisi manual.
BLOB_READ_WRITE_TOKEN=
